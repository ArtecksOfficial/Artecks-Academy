{
  // Used only by `npm run build:ios` (next.config.ts → typescript.tsconfigPath).
  // Same as tsconfig.json minus .next/dev/types: those are generated by
  // `next dev` for the web target and can list routes the iOS build excludes.
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next/dev"]
}
